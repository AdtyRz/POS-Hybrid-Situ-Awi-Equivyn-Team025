# =====================================================================
# Contoh environment variables untuk deployment Coolify.
# Salin nilainya ke tab Environment Variables di dashboard Coolify.
# Jangan commit file .env asli.
# =====================================================================

APP_NAME=Saung Situ Awi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tim025.server.smkbudibakti.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL yang dibuat lewat menu Database di Coolify.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Tanpa Redis: cache & session memakai PostgreSQL.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Coolify berada di belakang reverse proxy (Traefik/Caddy).
# Gunakan rentang CIDR, bukan "*", karena bootstrap/app.php membaca nilai
# sebagai daftar alamat.
TRUSTED_PROXIES=0.0.0.0/0,::/0

# Entrypoint image menjalankan migrasi otomatis saat container start.
RUN_MIGRATIONS=true
RUN_SEED=false

# Wajib diisi jika RUN_SEED=true (APP_ENV=production).
SEED_ADMIN_PASSWORD=
SEED_KASIR_PASSWORD=
SEED_PELAYAN_PASSWORD=
SEED_KOKI_PASSWORD=
SEED_BARISTA_PASSWORD=

MAIL_MAILER=log
